{
  "watch": [
    "server.js",
    "routes/**/*.js",
    "services/**/*.js",
    "config/**/*.js",
    "middleware/**/*.js",
    "database/**/*.js",
    "migrations/**/*.js"
  ],
  "ignore": [
    "node_modules/**",
    "uploads/**",
    "backups/**",
    "logs/**",
    "*.log",
    "test/**",
    "scripts/**",
    ".git/**"
  ],
  "ext": "js,json,sql",
  "delay": 3000,
  "verbose": false,
  "env": {
    "NODE_ENV": "development"
  }
}
