const { GoogleGenerativeAI } = require('@google/generative-ai');
const GeminiPromptBuilder = require('./GeminiPromptBuilder');
const { MASTER_SYSTEM_PROMPT } = require('../config/systemPrompt');

class GeminiService {
  constructor() {
    this.genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);
    this.model = this.genAI.getGenerativeModel({ 
      model: process.env.GEMINI_MODEL || 'gemini-1.5-pro',
      generationConfig: {
        temperature: 0.7,
        topK: 40,
        topP: 0.95,
        maxOutputTokens: 8192,
        responseMimeType: 'application/json'
      }
    });
    this.promptBuilder = new GeminiPromptBuilder();
  }

  _fillSystemPrompt(config = {}) {
    return MASTER_SYSTEM_PROMPT
      .replace('{{school_name}}', config.schoolName || config.school || 'Skoolific School')
      .replace('{{class_name}}', config.grade || config.className || '')
      .replace('{{subject_name}}', config.subject || '')
      .replace('{{chapter_name}}', config.chapter || config.unit || '')
      .replace('{{language}}', config.language || 'English')
      .replace('{{teacher_prompt}}', config.teacherPrompt || config.topic || '')
      .replace('{{retrieved_context}}', config.retrievedContext || 'No additional context provided.');
  }

  _buildRequest(prompt, systemInstruction) {
    const request = {
      contents: [{ role: 'user', parts: [{ text: prompt }] }]
    };
    if (systemInstruction) {
      request.systemInstruction = { parts: [{ text: systemInstruction }] };
    }
    return request;
  }
  
  async generateExam(examConfig, retryCount = 0) {
    const MAX_RETRIES = 3;
    
    try {
      const systemPrompt = this._fillSystemPrompt({
        grade: examConfig.grade,
        subject: examConfig.subject,
        chapter: examConfig.unit,
        language: examConfig.language,
        teacherPrompt: examConfig.teacherPrompt,
        retrievedContext: examConfig.retrievedContext
      });
      const prompt = this.promptBuilder.buildExamPrompt(examConfig);
      const result = await this.model.generateContent(this._buildRequest(prompt, systemPrompt));
      const response = await result.response;
      const text = response.text();
      
      const examData = JSON.parse(text);
      this.validateExamStructure(examData);
      
      return examData;
    } catch (error) {
      if (error.message.includes('RATE_LIMIT') || error.message.includes('429')) {
        throw new Error('API rate limit exceeded. Please try again in a few moments.');
      } else if (error.message.includes('INVALID_API_KEY') || error.message.includes('API_KEY') || error.message.includes('401')) {
        throw new Error('Invalid Gemini API key. Please check configuration.');
      } else if (error instanceof SyntaxError) {
        throw new Error(`Exam generation failed: Invalid JSON response from AI - ${error.message}`);
      } else {
        if (this.shouldRetry(error) && retryCount < MAX_RETRIES) {
          const delay = Math.pow(2, retryCount) * 1000;
          await this.sleep(delay);
          return this.generateExam(examConfig, retryCount + 1);
        }
        throw new Error(`Exam generation failed: ${error.message}`);
      }
    }
  }
  
  /**
   * Generate content from a raw prompt with retry logic
   * @param {string} prompt - The user prompt to send
   * @param {Object} [config] - Optional config with template variables (schoolName, grade, subject, etc.)
   * @param {number} [retryCount=0] - Current retry attempt
   * @returns {Promise<Object>} Parsed JSON response
   */
  async generateContent(prompt, config = {}, retryCount = 0) {
    const MAX_RETRIES = 3;

    try {
      const systemPrompt = this._fillSystemPrompt(config);
      const result = await this.model.generateContent(this._buildRequest(prompt, systemPrompt));
      const response = await result.response;
      const text = response.text();
      return JSON.parse(text);
    } catch (error) {
      if (error.message.includes('RATE_LIMIT') || error.message.includes('429')) {
        throw new Error('API rate limit exceeded. Please try again in a few moments.');
      } else if (error.message.includes('INVALID_API_KEY') || error.message.includes('API_KEY') || error.message.includes('401')) {
        throw new Error('Invalid Gemini API key. Please check configuration.');
      } else if (error instanceof SyntaxError) {
        throw new Error(`Content generation failed: Invalid JSON response from AI - ${error.message}`);
      } else {
        if (this.shouldRetry(error) && retryCount < MAX_RETRIES) {
          const delay = Math.pow(2, retryCount) * 1000;
          await this.sleep(delay);
          return this.generateContent(prompt, config, retryCount + 1);
        }
        throw new Error(`Content generation failed: ${error.message}`);
      }
    }
  }

  shouldRetry(error) {
    // Don't retry rate limits, auth errors, or validation errors
    if (error.message.includes('RATE_LIMIT') || 
        error.message.includes('429') ||
        error.message.includes('INVALID_API_KEY') ||
        error.message.includes('401') ||
        error.message.includes('Invalid exam structure')) {
      return false;
    }
    
    // Retry network errors, timeouts, and other transient errors
    return true;
  }
  
  sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
  
  validateExamStructure(examData) {
    if (!examData.exam || !examData.exam.questions) {
      throw new Error('Invalid exam structure returned from AI');
    }
    
    // Validate each question has required fields
    examData.exam.questions.forEach((q, index) => {
      if (!q.type || !q.question || !q.marks || !q.correctAnswer) {
        throw new Error(`Question ${index + 1} is missing required fields`);
      }
    });
    
    return true;
  }
}

module.exports = GeminiService;
