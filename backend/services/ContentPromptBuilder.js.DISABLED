const GeminiPromptBuilder = require('./GeminiPromptBuilder');

class ContentPromptBuilder extends GeminiPromptBuilder {
  /**
   * Build a lesson plan prompt
   */
  buildLessonPlanPrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English',
      learningObjectives, teachingMaterials, timeAllocation = 40
    } = config;

    const languageGuidance = this._getLanguageGuidance(language);

    return `
**TASK**: Create a comprehensive LESSON PLAN for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}.

**LESSON PLAN FORMAT** — Return as JSON:
{
  "lessonPlan": {
    "topic": "${topic}",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "language": "${language}",
    "learningObjectives": ["string - 3-5 objectives starting with 'By the end of this lesson, students will be able to...'"],
    "teachingMaterials": ["string - list of materials needed"],
    "introduction": "string - engaging intro to capture attention (5 min)",
    "mainActivities": [
      {
        "step": 1,
        "duration": "string - minutes",
        "teacherActivity": "string - what the teacher does",
        "studentActivity": "string - what the students do"
      }
    ],
    "assessmentMethod": "string - how learning is assessed",
    "summary": "string - wrap-up and key takeaways (5 min)",
    "homework": "string - assignment for students",
    "timeAllocation": {
      "introduction": "5 minutes",
      "mainActivities": "${Math.max(timeAllocation - 15, 20)} minutes",
      "assessment": "5 minutes",
      "summary": "5 minutes",
      "total": "${timeAllocation} minutes"
    }
  }
}

${languageGuidance}

Generate the lesson plan JSON now.
`;
  }

  /**
   * Build a lesson note prompt
   */
  buildLessonNotePrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English'
    } = config;

    const languageGuidance = this._getLanguageGuidance(language);

    return `
**TASK**: Create a LESSON NOTE for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}.

**LESSON NOTE FORMAT** — Return as JSON:
{
  "lessonNote": {
    "topic": "${topic}",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "introduction": "string - brief intro connecting to prior knowledge",
    "detailedExplanation": [
      {
        "heading": "string - section heading",
        "content": "string - detailed explanation in student-friendly language",
        "keyPoints": ["string - bullet points"]
      }
    ],
    "keyConcepts": [
      {
        "term": "string",
        "definition": "string - age-appropriate definition"
      }
    ],
    "examples": [
      {
        "problem": "string - question or scenario",
        "solution": "string - step-by-step solution or explanation"
      }
    ],
    "classroomActivities": [
      {
        "activity": "string - activity description",
        "instructions": "string - step-by-step instructions",
        "duration": "string - estimated time"
      }
    ],
    "importantNotes": ["string - common mistakes, tips, or additional notes"],
    "summary": "string - concise summary of the lesson",
    "reviewQuestions": [
      {
        "question": "string",
        "expectedAnswer": "string"
      }
    ]
  }
}

${languageGuidance}

Generate the lesson note JSON now.
`;
  }

  /**
   * Build a homework prompt
   */
  buildHomeworkPrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English',
      difficulty = 'Medium', questionTypes = ['multiple_choice', 'short_answer', 'true_false'],
      mcqCount = 5, shortAnswerCount = 3, tfCount = 5, fillBlankCount = 5, matchingCount = 5
    } = config;

    const difficultyGuidance = this._getDifficultyGuidance(difficulty);
    const languageGuidance = this._getLanguageGuidance(language);

    let questionSpecs = [];
    if (questionTypes.includes('multiple_choice')) questionSpecs.push(`${mcqCount} Multiple Choice questions (4 options each, A-D)`);
    if (questionTypes.includes('short_answer')) questionSpecs.push(`${shortAnswerCount} Short Answer questions`);
    if (questionTypes.includes('true_false')) questionSpecs.push(`${tfCount} True/False questions`);
    if (questionTypes.includes('fill_blank')) questionSpecs.push(`${fillBlankCount} Fill-in-the-Blank questions`);
    if (questionTypes.includes('matching')) questionSpecs.push(`${matchingCount} Matching questions (two columns)`);

    return `
**TASK**: Create a HOMEWORK assignment for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}.

**HOMEWORK FORMAT** — Return as JSON:
{
  "homework": {
    "topic": "${topic}",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "instructions": "string - clear instructions for students",
    "questions": [
      {
        "id": 1,
        "type": "multiple_choice",
        "question": "string",
        "options": ["A. option1", "B. option2", "C. option3", "D. option4"],
        "correctAnswer": "A",
        "explanation": "string - educational explanation"
      }
    ],
    "totalQuestions": number,
    "answerKey": "string - optional, for teacher reference"
  }
}

**QUESTION DISTRIBUTION**:
${questionSpecs.join('\n')}

Difficulty: ${difficulty}
${difficultyGuidance}
${languageGuidance}

Generate the homework JSON now.
`;
  }

  /**
   * Build a worksheet prompt
   */
  buildWorksheetPrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English',
      difficulty = 'Medium', activityTypes = ['exercises', 'matching', 'fill_blanks', 'identification', 'short_writing']
    } = config;

    const languageGuidance = this._getLanguageGuidance(language);

    let activitySpecs = [];
    if (activityTypes.includes('exercises')) activitySpecs.push('- Practice Exercises: 5 computation or problem-solving exercises');
    if (activityTypes.includes('matching')) activitySpecs.push('- Matching Activity: Match items from two columns');
    if (activityTypes.includes('fill_blanks')) activitySpecs.push('- Fill in the Blanks: 5 sentences with missing words');
    if (activityTypes.includes('identification')) activitySpecs.push('- Identification: Label, identify, or classify items');
    if (activityTypes.includes('short_writing')) activitySpecs.push('- Short Writing Task: Brief written response or paragraph');

    return `
**TASK**: Create a WORKSHEET for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}.

**WORKSHEET FORMAT** — Return as JSON:
{
  "worksheet": {
    "topic": "${topic}",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "studentName": "____________________",
    "date": "____________________",
    "instructions": "string - general instructions",
    "sections": [
      {
        "title": "string - section title",
        "type": "exercises|matching|fill_blanks|identification|short_writing",
        "instructions": "string - section-specific instructions",
        "questions": [
          {
            "id": 1,
            "question": "string",
            "answer": "string",
            "hint": "string - optional helpful hint"
          }
        ]
      }
    ],
    "bonusChallenge": "string - optional extra challenge"
  }
}

**ACTIVITY TYPES TO INCLUDE**:
${activitySpecs.join('\n')}

${languageGuidance}

Generate the worksheet JSON now.
`;
  }

  /**
   * Build a test prompt (short, focused assessment)
   */
  buildTestPrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English',
      difficulty = 'Medium', totalMarks = 20, timeLimit = 20
    } = config;

    const difficultyGuidance = this._getDifficultyGuidance(difficulty);
    const languageGuidance = this._getLanguageGuidance(language);

    return `
**TASK**: Create a SHORT TEST for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}.

**TEST SPECIFICATIONS**:
- Total Marks: ${totalMarks}
- Time Limit: ${timeLimit} minutes
- Difficulty: ${difficulty}
- Language: ${language}

**TEST FORMAT** — Return as JSON:
{
  "test": {
    "title": "string",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "totalMarks": ${totalMarks},
    "timeLimit": ${timeLimit},
    "instructions": "string - clear test instructions",
    "sections": [
      {
        "section": "A",
        "title": "string",
        "type": "multiple_choice|true_false|fill_blank|short_answer",
        "marks": number,
        "instructions": "string",
        "questions": [
          {
            "id": 1,
            "question": "string",
            "marks": number,
            "options": ["A. option1", "B. option2", "C. option3", "D. option4"],
            "correctAnswer": "string",
            "explanation": "string"
          }
        ]
      }
    ]
  }
}

${difficultyGuidance}
${languageGuidance}

Generate the test JSON now.
`;
  }

  /**
   * Build a scramble exam prompt (base exam + 3 shuffled versions)
   */
  buildScrambleExamPrompt(config) {
    const {
      topic, grade, subject, chapter, language = 'English',
      difficulty = 'Medium', totalMarks = 50, timeLimit = 60,
      questionDistribution = [
        { type: 'multiple_choice', count: 10, marksEach: 2 },
        { type: 'true_false', count: 5, marksEach: 2 },
        { type: 'short_answer', count: 4, marksEach: 5 }
      ]
    } = config;

    const difficultyGuidance = this._getDifficultyGuidance(difficulty);
    const languageGuidance = this._getLanguageGuidance(language);

    return `
**TASK**: Create an EXAMINATION for ${subject}, ${grade}, Topic: "${topic}"${chapter ? `, Chapter: ${chapter}` : ''}, then generate 3 shuffled versions (A, B, C) by reordering questions and shuffling MCQ option order.

**EXAM SPECIFICATIONS**:
- Total Marks: ${totalMarks}
- Time Limit: ${timeLimit} minutes
- Difficulty: ${difficulty}
- Language: ${language}

**EXAM FORMAT** — Return as JSON:
{
  "scrambleExam": {
    "title": "string",
    "grade": "${grade}",
    "subject": "${subject}"${chapter ? `,\n    "chapter": "${chapter}"` : ''},
    "totalMarks": ${totalMarks},
    "timeLimit": ${timeLimit},
    "instructions": "string - general exam instructions",
    "versions": {
      "A": {
        "label": "Version A",
        "sections": [
          {
            "section": "A",
            "type": "multiple_choice",
            "instructions": "Choose the correct answer",
            "totalMarks": number,
            "questions": [
              {
                "id": 1,
                "question": "string",
                "marks": number,
                "options": ["A. option1", "B. option2", "C. option3", "D. option4"],
                "correctAnswer": "A",
                "explanation": "string"
              }
            ]
          },
          {
            "section": "B",
            "type": "true_false",
            "instructions": "Write True or False",
            "totalMarks": number,
            "questions": [
              {
                "id": number,
                "question": "string",
                "marks": number,
                "correctAnswer": "True",
                "explanation": "string"
              }
            ]
          },
          {
            "section": "C",
            "type": "short_answer",
            "instructions": "Answer briefly",
            "totalMarks": number,
            "questions": [
              {
                "id": number,
                "question": "string",
                "marks": number,
                "correctAnswer": "string",
                "explanation": "string"
              }
            ]
          }
        ]
      },
      "B": {
        "label": "Version B",
        "sections": [ ... same questions in DIFFERENT ORDER, MCQ options SHUFFLED ... ]
      },
      "C": {
        "label": "Version C",
        "sections": [ ... same questions in DIFFERENT ORDER, MCQ options SHUFFLED ... ]
      }
    },
    "answerKey": {
      "A": { "1": "A", "2": "False", ... },
      "B": { "1": "D", "2": "True", ... },
      "C": { "1": "B", "2": "False", ... }
    }
  }
}

**QUESTION DISTRIBUTION**:
${questionDistribution.map(qt => `- ${qt.count} ${qt.type} questions (${qt.marksEach} marks each)`).join('\n')}

**VERSION SHUFFLING RULES**:
1. Version B: Reorder all questions randomly, shuffle MCQ option order
2. Version C: Reorder all questions randomly (different order from B), shuffle MCQ option order differently
3. Preserve the same questions across all versions
4. Update correctAnswer to match the shuffled options
5. Ensure each version has the same total marks
6. Keep questions grouped by type in the same order within each section

${difficultyGuidance}
${languageGuidance}

Generate the scramble exam JSON now.
`;
  }
}

module.exports = ContentPromptBuilder;
